# 複製這個檔案成 .env，再把值填進去。
# .env 不要上傳到 GitHub（.gitignore 已經擋掉了）。

# ── LINE Developers 後台 → 你的 Messaging API channel ──
# Messaging API 分頁最下面，「Channel access token (long-lived)」按 Issue
LINE_CHANNEL_ACCESS_TOKEN=

# Basic settings 分頁，「Channel secret」
LINE_CHANNEL_SECRET=

# ── 機器人對外的網址 ──
# 部署後平台會給你，例如 https://fuju-bot.onrender.com
# 結尾不要加斜線。圖片訊息要靠它組網址，LINE 只吃 HTTPS。
PUBLIC_BASE_URL=

# ── 同仁待辦頁面的通行碼 ──
# 自己隨便設一組長一點的亂碼，例如用這行產生：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 這組會出現在網址上，所以那個連結不要外流。
ADMIN_TOKEN=

# ── 同仁的 LINE 群組 ID ──
# 🔒 這個值決定「誰看得到民眾的留言」。機器人只認這一個群組，
#    其他群組打「待辦」一律不理。不要填錯，也不要填非公務群組。
#
# 怎麼拿：先留空部署上去，把官方帳號拉進同仁群組，在群組講一句話，
#         看 Render 的 Logs 就會印出 groupId（Cxxxxx...），再回填這裡。
# 留空的話機器人一樣會跑，只是同仁收不到清單、也不能打「待辦」查詢。
STAFF_GROUP_ID=

# 本機測試用，部署平台通常會自己給
PORT=3000
